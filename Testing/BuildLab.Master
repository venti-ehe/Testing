<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="BuildLab.Master.cs" Inherits="Testing.BuildLabMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %></title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <style type="text/css">

   /* ============================================================
   BUILD//LAB DESIGN SYSTEM
   Defined once here in the master page and shared by every web form.
   ============================================================ */
/* BUILD//LAB v3 — shared visual system */
:root{
  --bg:#05070a; --bg2:#090e14; --panel:#0d141d; --panel2:#111b26;
  --ink:#f7fbff; --muted:#8fa0af; --muted2:#b7c4cf;
  --cyan:#4ce5ff; --cyan2:#00b9ff; --violet:#8b5cf6; --green:#43f5a7;
  --amber:#ffbd59; --red:#ff5d7a; --line:rgba(255,255,255,.10);
  --shadow:0 30px 90px rgba(0,0,0,.45);
  --radius:24px; --max:1240px;
}
*{box-sizing:border-box;font-style:normal}
html{scroll-behavior:smooth;background:var(--bg)}
body{margin:0;color:var(--ink);background:
  radial-gradient(1000px 500px at 15% -10%,rgba(76,229,255,.10),transparent 65%),
  radial-gradient(900px 600px at 100% 20%,rgba(139,92,246,.10),transparent 65%),
  linear-gradient(180deg,#05070a 0%,#070b10 60%,#05070a 100%);
  font-family:"Segoe UI",Arial,Helvetica,sans-serif;font-style:normal;font-synthesis:none;
  overflow-x:hidden;
}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.8),transparent 85%)}
a{color:inherit}
::selection{background:rgba(76,229,255,.28);color:#fff}

/* Top chrome */
.topbar{position:fixed;inset:0 0 auto 0;z-index:1000;height:74px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:22px;padding:0 28px;background:rgba(5,7,10,.76);backdrop-filter:blur(20px) saturate(140%);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;font-weight:950;letter-spacing:.08em;white-space:nowrap}
.brand-mark{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,var(--cyan),var(--violet));box-shadow:0 0 30px rgba(76,229,255,.25);position:relative}
.brand-mark:before,.brand-mark:after{content:"";position:absolute;background:#061018;border-radius:4px}.brand-mark:before{width:15px;height:5px;left:8px;top:8px}.brand-mark:after{width:5px;height:15px;left:8px;top:8px}
.brand small{display:block;color:var(--muted);font-size:.58rem;letter-spacing:.18em;margin-top:1px;font-weight:800}
.progress-nav{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:7px 0;min-width:0;max-width:100%}.progress-nav::-webkit-scrollbar{display:none}
.progress-nav a{position:relative;text-decoration:none;padding:9px 12px;border-radius:12px;color:#80909d;font-size:.76rem;font-weight:800;white-space:nowrap;border:1px solid transparent;transition:.25s ease}
.progress-nav a:hover{color:#fff;background:rgba(255,255,255,.04);border-color:var(--line)}
.progress-nav a.active{color:#071016;background:linear-gradient(135deg,var(--cyan),#9af1ff);box-shadow:0 8px 26px rgba(76,229,255,.16)}
.progress-nav a.active:after{content:"";position:absolute;left:22%;right:22%;bottom:-8px;height:2px;background:var(--cyan);box-shadow:0 0 14px var(--cyan)}
.scroll-meter{position:fixed;top:73px;left:0;height:2px;width:0;background:linear-gradient(90deg,var(--cyan),var(--violet),var(--green));z-index:1001;box-shadow:0 0 18px rgba(76,229,255,.5)}

/* Hero */
.hero{min-height:92vh;display:grid;align-items:center;padding:126px max(6vw,28px) 76px;position:relative;overflow:hidden}
.hero:after{content:"";position:absolute;width:640px;height:640px;border-radius:50%;right:-180px;top:100px;background:radial-gradient(circle,rgba(76,229,255,.09),transparent 68%);filter:blur(4px);pointer-events:none}
.hero-inner{max-width:var(--max);margin:0 auto;width:100%;display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:66px;align-items:center}
.kicker{display:inline-flex;align-items:center;gap:9px;padding:8px 12px;border:1px solid rgba(76,229,255,.18);border-radius:999px;background:rgba(76,229,255,.07);color:#9af2ff;text-transform:uppercase;letter-spacing:.13em;font-weight:900;font-size:.72rem}
.kicker i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 14px var(--green)}
h1{font-size:clamp(3.5rem,7vw,7.6rem);line-height:.88;letter-spacing:-.065em;margin:22px 0 24px;max-width:900px}
h1 .accent{display:block;background:linear-gradient(90deg,var(--cyan),#f4fbff 55%,#b5a7ff);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-copy{font-size:clamp(1.02rem,1.5vw,1.28rem);line-height:1.75;color:var(--muted2);max-width:720px;margin:0}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.btn{display:inline-flex;align-items:center;gap:10px;padding:13px 18px;border-radius:12px;text-decoration:none;font-weight:900;border:1px solid var(--line);background:rgba(255,255,255,.04);transition:.25s ease}
.btn:hover{transform:translateY(-2px);background:rgba(255,255,255,.075)}
.btn.primary{border-color:transparent;color:#061018;background:linear-gradient(135deg,var(--cyan),#9bf4ff);box-shadow:0 14px 38px rgba(76,229,255,.16)}
.stat-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.stat{padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.025);color:#a8b6c2;font-size:.76rem;font-weight:800}.stat b{color:#fff}

/* Visual laboratory */
.lab-visual{position:relative;min-height:560px;border-radius:30px;border:1px solid rgba(255,255,255,.10);background:linear-gradient(145deg,rgba(16,25,35,.90),rgba(5,8,12,.95));box-shadow:var(--shadow);overflow:hidden;isolation:isolate}
.lab-visual:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 42%,rgba(76,229,255,.12),transparent 42%),linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:auto,32px 32px,32px 32px;z-index:-1}
.lab-visual .label{position:absolute;top:18px;left:18px;padding:8px 10px;border-radius:10px;background:rgba(4,8,12,.74);border:1px solid var(--line);font-size:.68rem;font-weight:900;letter-spacing:.12em;color:#a5b4c0;text-transform:uppercase;z-index:20}
.product{position:absolute;object-fit:contain;filter:drop-shadow(0 26px 36px rgba(0,0,0,.55));transition:transform .35s ease,filter .35s ease}
.lab-visual:hover .product{filter:drop-shadow(0 32px 42px rgba(0,0,0,.65)) drop-shadow(0 0 22px rgba(76,229,255,.08))}
.orbit{position:absolute;border:1px solid rgba(76,229,255,.15);border-radius:50%;animation:spin 22s linear infinite}.orbit.o1{width:310px;height:310px;left:50%;top:50%;transform:translate(-50%,-50%)}.orbit.o2{width:430px;height:430px;left:50%;top:50%;transform:translate(-50%,-50%);animation-direction:reverse;animation-duration:30s}.orbit:after{content:"";position:absolute;width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 16px var(--cyan);left:50%;top:-4px}
@keyframes spin{to{rotate:360deg}}

/* Content */
.section{padding:96px max(6vw,28px)}
.section-inner{max-width:var(--max);margin:0 auto}
.section-head{display:grid;grid-template-columns:.8fr 1.2fr;gap:54px;align-items:end;margin-bottom:34px}
.eyebrow{color:var(--cyan);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;font-weight:950;margin-bottom:10px}.section h2{font-size:clamp(2.3rem,4vw,4.7rem);line-height:.98;letter-spacing:-.05em;margin:0}.section-lede{color:var(--muted2);font-size:1.06rem;line-height:1.75;max-width:720px;margin:0}
.cards{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.card{grid-column:span 4;padding:26px;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(17,27,38,.88),rgba(8,13,19,.92));box-shadow:0 18px 50px rgba(0,0,0,.22);position:relative;overflow:hidden;transform-style:preserve-3d;transition:border-color .25s,transform .25s}.card:before{content:"";position:absolute;inset:-1px;background:radial-gradient(360px circle at var(--mx,50%) var(--my,50%),rgba(76,229,255,.10),transparent 48%);opacity:0;transition:.3s;pointer-events:none}.card:hover{border-color:rgba(76,229,255,.28);transform:translateY(-4px)}.card:hover:before{opacity:1}.card .num{font-size:.66rem;color:var(--cyan);font-weight:950;letter-spacing:.15em;text-transform:uppercase}.card h3{font-size:1.32rem;margin:10px 0 8px}.card p{color:#9eacb7;line-height:1.65;margin:0}.card.wide{grid-column:span 8}.card.full{grid-column:1/-1}.card.warning{border-color:rgba(255,93,122,.20);background:linear-gradient(145deg,rgba(53,16,28,.44),rgba(10,11,16,.94))}.card.warning .num{color:#ff8da5}.card.success{border-color:rgba(67,245,167,.18)}.card.success .num{color:var(--green)}
.checks{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:16px}.check{padding:11px 12px;border-radius:12px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.075);color:#bac6cf;font-size:.86rem}.check:before{content:"✓";color:var(--green);font-weight:950;margin-right:8px}
.callout{margin-top:18px;padding:16px 18px;border-radius:15px;border:1px solid rgba(76,229,255,.16);background:rgba(76,229,255,.055);color:#cbeef4;line-height:1.6}.callout strong{color:#fff}.callout.danger{border-color:rgba(255,93,122,.2);background:rgba(255,93,122,.055);color:#ffdce5}

/* Parts grid */
.parts-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.part-card{min-height:390px;position:relative;border-radius:26px;border:1px solid var(--line);overflow:hidden;background:linear-gradient(160deg,#101923,#080c12);padding:22px;display:flex;flex-direction:column;justify-content:flex-end;isolation:isolate;transition:.3s ease}.part-card:hover{transform:translateY(-6px);border-color:rgba(76,229,255,.3);box-shadow:0 30px 70px rgba(0,0,0,.28)}.part-card:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 30%,rgba(76,229,255,.12),transparent 45%);z-index:-1}.part-card img{position:absolute;top:36px;left:12%;width:76%;height:190px;object-fit:contain;filter:drop-shadow(0 22px 24px rgba(0,0,0,.55));transition:.35s ease}.part-card:hover img{transform:scale(1.06) translateY(-4px)}.part-card .role{color:var(--cyan);font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;font-weight:900}.part-card h3{font-size:1.5rem;margin:7px 0}.part-card p{color:#9aabb8;margin:0;line-height:1.55;font-size:.92rem}

/* Blueprint visuals */
.blueprint{position:relative;min-height:610px;border:1px solid var(--line);border-radius:28px;background:linear-gradient(160deg,#0e1821,#05080c);overflow:hidden}.blueprint:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(76,229,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(76,229,255,.035) 1px,transparent 1px);background-size:28px 28px}.bp-tag{position:absolute;padding:7px 9px;border:1px solid rgba(76,229,255,.18);background:rgba(4,9,13,.75);border-radius:9px;color:#a9eaf4;font-size:.63rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.bp-line{position:absolute;height:1px;background:linear-gradient(90deg,var(--cyan),transparent);transform-origin:left center;opacity:.45}

/* Page-specific stage compositions */
.cpu-stage .mobo{width:88%;height:74%;left:6%;top:18%;opacity:.72}.cpu-stage .cpu{width:28%;height:28%;left:36%;top:35%;z-index:3;animation:float 4s ease-in-out infinite}.cpu-stage .tri{position:absolute;width:12px;height:12px;border-left:3px solid var(--amber);border-bottom:3px solid var(--amber);transform:rotate(-45deg);left:45%;top:58%;filter:drop-shadow(0 0 8px var(--amber));z-index:6}.cpu-stage .socket-glow{position:absolute;width:170px;height:170px;border:2px solid rgba(255,189,89,.25);box-shadow:0 0 70px rgba(255,189,89,.13),inset 0 0 45px rgba(255,189,89,.07);left:50%;top:50%;transform:translate(-50%,-50%);border-radius:24px;z-index:2}
@keyframes float{50%{transform:translateY(-10px)}}
.cool-stage .mobo{width:72%;height:62%;left:14%;bottom:5%;opacity:.55}.cool-stage .cpu{width:20%;height:20%;left:40%;bottom:31%;z-index:4}.radiator{position:absolute;left:11%;right:11%;top:78px;height:128px;border-radius:18px;background:linear-gradient(#19232c,#0a0f14);border:1px solid #34434f;display:flex;gap:18px;align-items:center;justify-content:center;box-shadow:0 18px 38px rgba(0,0,0,.45)}.fan{width:92px;height:92px;border-radius:50%;border:8px solid #141b21;background:repeating-conic-gradient(#263640 0 16deg,#0c1217 16deg 32deg);box-shadow:inset 0 0 20px rgba(76,229,255,.18);animation:fan 1.4s linear infinite}@keyframes fan{to{rotate:360deg}}.pump{position:absolute;width:118px;height:92px;border-radius:20px;left:50%;bottom:24%;transform:translateX(-50%);background:linear-gradient(145deg,#26353f,#0a0e12);border:1px solid #41515d;box-shadow:0 0 38px rgba(76,229,255,.15);z-index:6}.pump:after{content:"AIO // PUMP";position:absolute;inset:0;display:grid;place-items:center;font-size:.66rem;color:var(--cyan);font-weight:950;letter-spacing:.1em}.tube{position:absolute;height:6px;width:185px;background:#202b32;border-radius:10px;transform-origin:left;z-index:5}.tube.t1{left:53%;top:34%;rotate:42deg}.tube.t2{left:46%;top:34%;rotate:138deg}.air{position:absolute;font-size:1.3rem;color:rgba(76,229,255,.55);animation:air 2.2s ease-in-out infinite}@keyframes air{50%{transform:translateY(-14px);opacity:.25}}.air.a1{top:25px;left:30%}.air.a2{top:28px;left:49%;animation-delay:.4s}.air.a3{top:24px;left:68%;animation-delay:.8s}
.ram-stage .mobo{width:90%;height:78%;left:5%;top:12%;opacity:.62}.ram-stick-v{position:absolute;width:30px;height:180px;border-radius:6px;background:linear-gradient(90deg,#1f2f39,#0c1217);border:1px solid #4d626f;top:26%;z-index:5;box-shadow:0 0 30px rgba(76,229,255,.10)}.ram-stick-v:after{content:"DDR5";position:absolute;rotate:90deg;left:-8px;top:77px;color:#eafcff;font-size:.65rem;font-weight:950;letter-spacing:.12em}.ram-stick-v.a2{right:31%}.ram-stick-v.b2{right:20%;box-shadow:0 0 30px rgba(139,92,246,.18)}.ram-stage .slotlabel{position:absolute;top:21%;right:17%;display:flex;gap:22px;color:#8ea0ae;font-size:.58rem;font-weight:900;letter-spacing:.1em}.ram-stage .slotlabel b:nth-child(2),.ram-stage .slotlabel b:nth-child(4){color:var(--cyan)}
.case-stage .case{width:78%;height:82%;left:10%;top:10%;opacity:.74}.case-stage .mobo{width:47%;height:44%;left:29%;top:28%;z-index:4}.case-stage .psu{width:39%;height:23%;left:34%;bottom:8%;z-index:6}.standoff{position:absolute;width:12px;height:12px;border-radius:50%;background:var(--amber);box-shadow:0 0 18px rgba(255,189,89,.5);z-index:7}.s1{left:34%;top:31%}.s2{left:67%;top:31%}.s3{left:34%;top:61%}.s4{left:67%;top:61%}
.gpu-stage .case{width:80%;height:83%;left:9%;top:9%;opacity:.44}.gpu-stage .mobo{width:56%;height:53%;left:22%;top:19%;opacity:.66}.gpu-stage .gpu{width:62%;height:36%;left:19%;top:42%;z-index:6;animation:float 4s ease-in-out infinite}.gpu-stage .power{position:absolute;width:160px;height:6px;border-radius:9px;background:linear-gradient(90deg,#404c56,#161b20);right:8%;top:46%;rotate:-14deg;z-index:5}.gpu-stage .power:after{content:"GPU POWER";position:absolute;right:0;top:-22px;color:#a8b8c4;font-size:.56rem;font-weight:950;letter-spacing:.1em}

/* Timeline / step rail */
.timeline{display:grid;grid-template-columns:280px 1fr;gap:34px;align-items:start}.timeline-rail{position:sticky;top:108px;padding:22px;border-radius:20px;border:1px solid var(--line);background:rgba(10,15,21,.72);backdrop-filter:blur(14px)}.timeline-rail strong{display:block;font-size:.74rem;color:#fff;letter-spacing:.12em;text-transform:uppercase;margin-bottom:12px}.timeline-rail a{display:flex;gap:10px;align-items:center;text-decoration:none;color:#8494a1;padding:9px 0;font-size:.85rem;font-weight:750}.timeline-rail a span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;border:1px solid var(--line);font-size:.66rem;color:#b6c3cd}.timeline-rail a:hover{color:#fff}.timeline-body{display:grid;gap:16px}.lesson{padding:30px;border-radius:24px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(15,23,32,.92),rgba(7,11,16,.94));box-shadow:0 18px 50px rgba(0,0,0,.20)}.lesson .stepno{color:var(--cyan);font-weight:950;letter-spacing:.14em;font-size:.67rem;text-transform:uppercase}.lesson h3{font-size:clamp(1.65rem,3vw,2.5rem);letter-spacing:-.035em;margin:10px 0 12px}.lesson p{color:#a8b6c2;line-height:1.75;margin:0 0 12px}.lesson ul{color:#a8b6c2;line-height:1.7}.lesson li{margin:8px 0}

/* Footer nav */
.page-nav{padding:34px max(6vw,28px) 70px;border-top:1px solid var(--line);background:#05070a}.page-nav-inner{max-width:var(--max);margin:0 auto;display:flex;justify-content:space-between;gap:16px}.next-card{flex:1;max-width:540px;text-decoration:none;padding:20px 22px;border-radius:18px;border:1px solid var(--line);background:linear-gradient(145deg,#0e151d,#080c11);transition:.25s}.next-card:hover{transform:translateY(-3px);border-color:rgba(76,229,255,.3)}.next-card small{display:block;color:#7e8d99;text-transform:uppercase;letter-spacing:.12em;font-size:.63rem;font-weight:900}.next-card strong{display:block;margin-top:5px;font-size:1.08rem}.next-card.next{text-align:right}.next-card.next strong{color:#bdf6ff}

/* Reveal + pointer */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .75s cubic-bezier(.2,.75,.25,1),transform .75s cubic-bezier(.2,.75,.25,1)}.reveal.in{opacity:1;transform:none}.cursor-glow{position:fixed;width:360px;height:360px;border-radius:50%;pointer-events:none;z-index:-1;background:radial-gradient(circle,rgba(76,229,255,.055),transparent 68%);transform:translate(-50%,-50%);left:50%;top:50%}

@media(max-width:1050px){.hero-inner{grid-template-columns:1fr;gap:42px}.lab-visual{min-height:520px}.section-head{grid-template-columns:1fr;gap:18px}.card,.card.wide{grid-column:span 6}.parts-grid{grid-template-columns:repeat(2,1fr)}.timeline{grid-template-columns:1fr}.timeline-rail{position:relative;top:0;display:none}}
@media(max-width:720px){.topbar{padding:0 14px;height:66px}.brand span:last-child{display:none}.scroll-meter{top:65px}.hero{padding:106px 20px 58px;min-height:auto}.hero-inner{gap:30px}h1{font-size:clamp(3.1rem,16vw,5rem)}.lab-visual{min-height:430px}.section{padding:70px 20px}.card,.card.wide{grid-column:1/-1}.parts-grid{grid-template-columns:1fr}.part-card{min-height:350px}.checks{grid-template-columns:1fr}.page-nav{padding:24px 20px 46px}.page-nav-inner{flex-direction:column}.next-card{max-width:none}.next-card.next{text-align:left}.radiator{left:5%;right:5%;height:105px;gap:10px}.fan{width:72px;height:72px}.cool-stage .mobo{width:86%;left:7%}.timeline-body{gap:12px}.lesson{padding:22px}.progress-nav a{padding:8px 9px;font-size:.7rem}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}.cursor-glow{display:none}}


/* BUILD//LAB v5 — extra stages + challenge system */
.tech-mono{font-family:Consolas,"SFMono-Regular","Courier New",monospace;font-style:normal}
.progress-nav{max-width:100%}
/* centre the links when they fit; if the window is too narrow they scroll instead of being clipped on the left */
.progress-nav>a:first-child{margin-left:auto}
.progress-nav>a:last-child{margin-right:auto}
.progress-nav a{flex:0 0 auto}
.nav-sep{flex:0 0 auto;width:1px;align-self:stretch;margin:6px 8px;background:var(--line)}
.progress-nav a.nav-extra{color:var(--muted2)}
.progress-nav a.nav-extra.active{color:#071016}
@media(max-width:1500px){.topbar{gap:14px;padding:0 20px}.progress-nav{gap:3px}.progress-nav a{padding:9px 9px;font-size:.72rem}.nav-sep{margin:6px 4px}}
@media(max-width:1180px){.brand small{display:none}}
@media(max-width:900px){.topbar{grid-template-columns:auto minmax(0,1fr)}}
.progress-nav a{font-style:normal}

/* M.2 / storage stage */
.storage-stage .mobo{width:90%;height:78%;left:5%;top:12%;opacity:.58}
.m2-board{position:absolute;width:220px;height:58px;left:50%;top:48%;transform:translate(-50%,-50%);border-radius:9px;background:linear-gradient(90deg,#1a4b36,#0f2b20);border:1px solid #3e7b61;box-shadow:0 0 38px rgba(67,245,167,.16);z-index:6}
.m2-board:before{content:"NVMe // M.2";position:absolute;left:18px;top:18px;color:#bdfbe0;font-size:.72rem;font-weight:950;letter-spacing:.12em}
.m2-board:after{content:"";position:absolute;right:-15px;top:19px;width:15px;height:20px;background:repeating-linear-gradient(90deg,#d8bb58 0 3px,#6f5a15 3px 5px)}
.m2-chip{position:absolute;width:30px;height:30px;background:#0a1110;border:1px solid #27483d;border-radius:4px;top:13px}.m2-chip.c1{left:92px}.m2-chip.c2{left:130px}.m2-chip.c3{left:168px}
.m2-screw{position:absolute;width:20px;height:20px;border-radius:50%;border:2px solid var(--amber);right:15%;top:49%;box-shadow:0 0 22px rgba(255,189,89,.45);z-index:7}.m2-screw:before,.m2-screw:after{content:"";position:absolute;background:var(--amber);left:4px;right:4px;height:1px;top:8px}.m2-screw:after{rotate:90deg}
.storage-beam{position:absolute;left:25%;right:25%;height:2px;top:58%;background:linear-gradient(90deg,transparent,var(--green),transparent);box-shadow:0 0 15px rgba(67,245,167,.4);animation:pulsebeam 2s ease-in-out infinite}@keyframes pulsebeam{50%{opacity:.25;transform:scaleX(.75)}}

/* Airflow stage */
.airflow-stage .case{width:78%;height:83%;left:11%;top:9%;opacity:.55}
.case-fan{position:absolute;width:82px;height:82px;border-radius:50%;border:7px solid #18232b;background:repeating-conic-gradient(#263945 0 18deg,#0a1015 18deg 36deg);box-shadow:inset 0 0 22px rgba(76,229,255,.14);animation:fan 1.25s linear infinite;z-index:5}
.case-fan.f1{left:17%;top:22%}.case-fan.f2{left:17%;top:41%;animation-delay:-.2s}.case-fan.f3{left:17%;top:60%;animation-delay:-.4s}.case-fan.f4{right:17%;top:25%;animation-direction:reverse}.case-fan.f5{right:17%;top:52%;animation-direction:reverse}
.flow-arrow{position:absolute;height:3px;border-radius:999px;z-index:8;filter:drop-shadow(0 0 7px currentColor)}
.flow-arrow:after{content:"";position:absolute;right:-2px;top:-5px;border-left:11px solid currentColor;border-top:6px solid transparent;border-bottom:6px solid transparent}
.flow-in{left:25%;width:28%;color:var(--cyan);background:currentColor}.flow-out{left:52%;width:23%;color:var(--amber);background:currentColor}
.flow-arrow.a{top:31%}.flow-arrow.b{top:50%}.flow-arrow.c{top:69%}
.pressure-chip{position:absolute;left:50%;bottom:7%;transform:translateX(-50%);padding:10px 14px;border-radius:12px;border:1px solid rgba(67,245,167,.25);background:rgba(5,12,10,.78);color:#aef7d3;font-size:.68rem;font-weight:950;letter-spacing:.1em;z-index:9}

/* BIOS stage */
.bios-stage{padding:55px 44px 38px}
.bios-screen{height:100%;border:1px solid rgba(76,229,255,.25);border-radius:18px;background:linear-gradient(180deg,#07111a,#04090e);box-shadow:inset 0 0 60px rgba(0,185,255,.05),0 22px 50px rgba(0,0,0,.35);overflow:hidden;position:relative}
.bios-head{height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid rgba(76,229,255,.16);color:#c8f8ff;font-weight:900;font-size:.78rem;letter-spacing:.1em}.bios-head b{color:var(--cyan)}
.bios-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:12px;padding:16px}.bios-pane{border:1px solid rgba(255,255,255,.08);border-radius:13px;background:rgba(255,255,255,.025);padding:14px}.bios-pane h4{margin:0 0 12px;color:#9eefff;font-size:.7rem;letter-spacing:.12em}.bios-row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05);font-size:.75rem;color:#9bacb8}.bios-row:last-child{border:0}.bios-row b{color:#f4fbff}.bios-ok{color:var(--green)!important}.bios-warn{color:var(--amber)!important}
.temp-dial{width:150px;height:150px;margin:18px auto;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--green) 0 46%,rgba(255,255,255,.07) 46% 100%);position:relative}.temp-dial:before{content:"";position:absolute;inset:13px;border-radius:50%;background:#071019}.temp-dial span{position:relative;text-align:center;font-size:1.75rem;font-weight:950}.temp-dial small{display:block;color:#78909f;font-size:.55rem;letter-spacing:.12em;margin-top:3px}

/* validation stage */
.validation-stage{padding:56px 38px 34px}
.telemetry{height:100%;display:grid;grid-template-rows:auto 1fr auto;gap:14px}.telemetry-head{display:flex;justify-content:space-between;align-items:center}.telemetry-head b{letter-spacing:.12em;font-size:.72rem;color:#bceffc}.live-dot{display:inline-flex;gap:7px;align-items:center;color:var(--green);font-size:.64rem;font-weight:900}.live-dot:before{content:"";width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green);animation:blink 1.1s infinite}@keyframes blink{50%{opacity:.25}}
.graph{position:relative;border:1px solid rgba(255,255,255,.08);border-radius:16px;overflow:hidden;background:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px),#060b10;background-size:40px 40px}.graph svg{position:absolute;inset:0;width:100%;height:100%}.graph .line1{fill:none;stroke:var(--cyan);stroke-width:3;filter:drop-shadow(0 0 5px rgba(76,229,255,.4));stroke-dasharray:1400;stroke-dashoffset:1400;animation:drawline 3s ease forwards}.graph .line2{fill:none;stroke:var(--amber);stroke-width:2;opacity:.75;stroke-dasharray:1400;stroke-dashoffset:1400;animation:drawline 3.5s .3s ease forwards}@keyframes drawline{to{stroke-dashoffset:0}}
.telemetry-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.telemetry-card{padding:11px;border:1px solid rgba(255,255,255,.08);border-radius:12px;background:rgba(255,255,255,.025)}.telemetry-card small{display:block;color:#6f8492;font-size:.58rem;letter-spacing:.08em;text-transform:uppercase}.telemetry-card b{display:block;margin-top:5px;font-size:1.05rem}.telemetry-card .good{color:var(--green)}

/* Final challenge */
.challenge-shell{max-width:1440px;margin:0 auto;padding:118px 28px 70px}
.challenge-head{display:flex;justify-content:space-between;gap:30px;align-items:flex-end;margin-bottom:20px}.challenge-head h1{font-size:clamp(2.7rem,5vw,5.4rem);margin:0;line-height:.92}.challenge-head p{max-width:600px;color:var(--muted2);line-height:1.65}
.hud{display:grid;grid-template-columns:repeat(5,minmax(110px,1fr));gap:10px;margin-bottom:14px}.hud-box{padding:13px 15px;border-radius:14px;border:1px solid var(--line);background:rgba(11,17,24,.85)}.hud-box small{display:block;color:#758795;text-transform:uppercase;letter-spacing:.11em;font-size:.58rem;font-weight:900}.hud-box b{display:block;margin-top:4px;font-size:1.16rem}.hud-box .cyan{color:var(--cyan)}.hud-box .green{color:var(--green)}.hud-box .amber{color:var(--amber)}
.game-layout{display:grid;grid-template-columns:minmax(270px,.34fr) minmax(590px,.66fr);gap:14px;min-height:700px}.inventory,.build-board{border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,rgba(14,22,31,.96),rgba(6,10,14,.97));box-shadow:var(--shadow);overflow:hidden}.inventory{padding:18px}.inventory-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.inventory-head h2{font-size:1rem;margin:0;letter-spacing:.08em;text-transform:uppercase}.mode-toggle{display:flex;border:1px solid var(--line);border-radius:10px;padding:3px;background:#070b10}.mode-toggle button{border:0;color:#8293a1;background:transparent;border-radius:7px;padding:6px 8px;font-weight:900;font-size:.64rem;cursor:pointer}.mode-toggle button.active{color:#071016;background:var(--cyan)}
.piece-list{display:grid;gap:8px}.game-piece{touch-action:none;user-select:none;cursor:grab;display:grid;grid-template-columns:42px 1fr auto;gap:10px;align-items:center;padding:10px;border:1px solid rgba(255,255,255,.09);border-radius:13px;background:linear-gradient(145deg,#111c26,#091016);transition:.18s;position:relative;z-index:10}.game-piece:hover{border-color:rgba(76,229,255,.28);transform:translateX(3px)}.game-piece.dragging{cursor:grabbing;opacity:.92;transform:scale(1.04);box-shadow:0 22px 45px rgba(0,0,0,.55),0 0 30px rgba(76,229,255,.14);position:fixed;pointer-events:none;width:300px;z-index:3000}.piece-icon{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;background:rgba(76,229,255,.08);border:1px solid rgba(76,229,255,.12);font-weight:950;color:#aaf3ff}.piece-copy strong{display:block;font-size:.82rem}.piece-copy small{display:block;color:#778a98;font-size:.66rem;margin-top:2px}.piece-tag{font-size:.57rem;color:#607584;text-transform:uppercase;font-weight:900;letter-spacing:.08em}.game-piece.installed{opacity:.25;pointer-events:none;filter:grayscale(1)}.pro-mode .piece-copy strong,.pro-mode .piece-copy small{color:transparent;text-shadow:0 0 9px rgba(255,255,255,.55)}.pro-mode .piece-tag{display:none}
.build-board{position:relative;min-height:700px;background:radial-gradient(circle at 52% 48%,rgba(76,229,255,.07),transparent 36%),linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(145deg,#0a1118,#05080c);background-size:auto,30px 30px,30px 30px,auto}.board-label{position:absolute;left:18px;top:15px;color:#7390a1;font-size:.62rem;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.motherboard-map{position:absolute;left:8%;right:8%;top:11%;bottom:8%;border:1px solid rgba(76,229,255,.15);border-radius:26px;background:linear-gradient(145deg,rgba(19,43,47,.38),rgba(7,17,22,.70));box-shadow:inset 0 0 65px rgba(76,229,255,.04)}.motherboard-map:before{content:"";position:absolute;inset:4%;border:1px dashed rgba(76,229,255,.10);border-radius:20px}.pcb-line{position:absolute;height:1px;background:rgba(76,229,255,.12);transform-origin:left}.drop-slot{position:absolute;border:2px dashed rgba(145,169,184,.28);border-radius:13px;background:rgba(255,255,255,.018);display:grid;place-items:center;text-align:center;padding:8px;color:#6e8290;font-size:.62rem;font-weight:950;letter-spacing:.08em;text-transform:uppercase;transition:.18s}.drop-slot.hot{border-color:var(--cyan);background:rgba(76,229,255,.10);color:#c5f7ff;box-shadow:0 0 35px rgba(76,229,255,.14)}.drop-slot.wrong{animation:shake .3s;background:rgba(255,93,122,.13);border-color:var(--red)}.drop-slot.correct{border-style:solid;border-color:rgba(67,245,167,.55);background:rgba(67,245,167,.08);color:#b9f8da}.drop-slot.correct:after{content:"✓ INSTALLED";font-size:.56rem;color:var(--green);margin-top:5px}.drop-slot.hint{animation:hintpulse .7s infinite alternate}@keyframes hintpulse{to{box-shadow:0 0 40px rgba(255,189,89,.45);border-color:var(--amber)}}@keyframes shake{25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}
.slot-cpu{left:41%;top:22%;width:18%;height:17%}.slot-ram{left:64%;top:19%;width:15%;height:28%}.slot-m2{left:43%;top:48%;width:25%;height:8%}.slot-gpu{left:22%;top:62%;width:56%;height:12%}.slot-atx{right:5%;top:38%;width:9%;height:24%}.slot-eps{left:7%;top:7%;width:18%;height:8%}.slot-pump{left:37%;top:7%;width:25%;height:10%}.slot-gpupower{right:7%;top:66%;width:16%;height:10%}.slot-front{left:8%;bottom:7%;width:19%;height:9%}.slot-fan{right:7%;bottom:7%;width:16%;height:9%}
.game-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.game-actions button{border:1px solid var(--line);background:#0d151d;color:#dce8ef;border-radius:11px;padding:10px 12px;font-weight:900;cursor:pointer}.game-actions button:hover{border-color:rgba(76,229,255,.3)}.game-actions .hint-btn{color:#161007;background:linear-gradient(135deg,var(--amber),#ffe2a9);border:0}.game-actions .reset-btn{color:#ffd8e0}
.game-toast{position:fixed;left:50%;bottom:30px;transform:translate(-50%,25px);opacity:0;z-index:4000;padding:12px 17px;border:1px solid var(--line);border-radius:13px;background:rgba(7,11,16,.94);backdrop-filter:blur(15px);font-weight:900;transition:.25s}.game-toast.show{opacity:1;transform:translate(-50%,0)}.game-toast.good{color:#b9f8da;border-color:rgba(67,245,167,.35)}.game-toast.bad{color:#ffd2dc;border-color:rgba(255,93,122,.35)}
.finish-modal{position:fixed;inset:0;z-index:5000;background:rgba(1,4,7,.80);backdrop-filter:blur(14px);display:none;place-items:center;padding:20px}.finish-modal.show{display:grid}.finish-card{width:min(620px,94vw);padding:34px;border-radius:26px;border:1px solid rgba(76,229,255,.2);background:linear-gradient(145deg,#101a24,#070b10);box-shadow:0 45px 110px rgba(0,0,0,.65);text-align:center;position:relative;overflow:hidden}.finish-card:before{content:"";position:absolute;inset:-30%;background:conic-gradient(transparent,var(--cyan),transparent,var(--violet),transparent);opacity:.08;animation:spin 8s linear infinite}.finish-card>*{position:relative}.rank-badge{width:96px;height:96px;margin:0 auto 15px;border-radius:50%;display:grid;place-items:center;font-size:2.1rem;font-weight:950;color:#061018;background:linear-gradient(135deg,var(--cyan),var(--green));box-shadow:0 0 45px rgba(76,229,255,.18)}.finish-card h2{font-size:2rem;margin:8px 0}.finish-card p{color:#9eb0bd;line-height:1.65}.finish-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:18px 0}.finish-stat{padding:13px;border-radius:13px;background:rgba(255,255,255,.035);border:1px solid var(--line)}.finish-stat small{display:block;color:#718594;font-size:.6rem;text-transform:uppercase;letter-spacing:.1em}.finish-stat b{display:block;font-size:1.2rem;margin-top:5px}.confetti{position:fixed;width:8px;height:14px;z-index:6000;pointer-events:none;animation:fall 1.6s ease-out forwards}@keyframes fall{to{transform:translate(var(--dx),var(--dy)) rotate(720deg);opacity:0}}

@media(max-width:1050px){.game-layout{grid-template-columns:1fr}.piece-list{grid-template-columns:repeat(2,1fr)}.build-board{min-height:650px}.challenge-head{display:block}.challenge-head p{margin-top:15px}.telemetry-cards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:720px){.hud{grid-template-columns:repeat(2,1fr)}.piece-list{grid-template-columns:1fr}.build-board{min-height:560px}.challenge-shell{padding:102px 14px 45px}.inventory{padding:12px}.motherboard-map{left:4%;right:4%}.drop-slot{font-size:.52rem}.finish-stats{grid-template-columns:1fr}.bios-stage{padding:46px 18px 22px}.bios-grid{grid-template-columns:1fr}.telemetry-cards{grid-template-columns:repeat(2,1fr)}}


/* Prevent synthetic/oblique glyph rendering in some browsers */
html, body, button, input, select, textarea {
  font-family: "Segoe UI", Arial, Helvetica, sans-serif !important;
  font-style: normal !important;
  font-synthesis: none !important;
}
  
/* ============================================================
   BUILD//LAB v6 — master page additions
   Footer tweak + shared styles for Home/About/Contact,
   the feedback Survey and the Long Long Forum community.
   ============================================================ */
.next-card.next{margin-left:auto}

/* Generic page wrapper for non-lesson pages (sits under the fixed top bar) */
.page-wrap{max-width:var(--max);margin:0 auto;padding:128px max(6vw,28px) 80px}
.page-head{margin-bottom:30px;max-width:820px}
.page-head h1{font-size:clamp(2.6rem,5.2vw,4.8rem);line-height:.95;letter-spacing:-.05em;margin:14px 0 16px}
.page-head p{color:var(--muted2);font-size:1.08rem;line-height:1.75;margin:0}
.panel{padding:26px;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(145deg,rgba(17,27,38,.88),rgba(8,13,19,.92));box-shadow:0 18px 50px rgba(0,0,0,.22)}
.panel h2{font-size:1.35rem;margin:0 0 6px;letter-spacing:-.02em}
.panel .sub{color:#8fa0af;font-size:.9rem;margin:0 0 18px;line-height:1.6}
.stack{display:grid;gap:16px}

/* Form controls */
.field{margin-bottom:16px}
.field>label,.field .lbl{display:block;font-size:.72rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#9fb3c1;margin-bottom:7px}
.field .opt{color:#677a88;font-weight:700;letter-spacing:.04em;text-transform:none;margin-left:6px}
.input,.field input[type=text],.field select,.field textarea{width:100%;padding:12px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:#070c12;color:var(--ink);font-size:.98rem;outline:none;transition:border-color .2s,box-shadow .2s}
.field textarea{min-height:130px;resize:vertical;line-height:1.6}
.field select option{background:#0d141d;color:var(--ink)}
.input:focus,.field input[type=text]:focus,.field select:focus,.field textarea:focus{border-color:rgba(76,229,255,.6);box-shadow:0 0 0 3px rgba(76,229,255,.12)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.err,.field-error{display:block;color:#ff8da5;font-size:.8rem;font-weight:800;margin-top:6px}
.alert{padding:14px 16px;border-radius:14px;margin-bottom:16px;line-height:1.55;font-size:.92rem}
.alert.bad{border:1px solid rgba(255,93,122,.28);background:rgba(255,93,122,.07);color:#ffd2dc}
.alert.good{border:1px solid rgba(67,245,167,.28);background:rgba(67,245,167,.07);color:#b9f8da}
.alert ul{margin:6px 0 0;padding-left:20px}
input.btn,button.btn{font-size:.95rem;cursor:pointer;color:var(--ink)}
input.btn.primary,button.btn.primary{color:#061018}
input.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.small{padding:9px 13px;font-size:.82rem}
.mini{display:inline-flex;align-items:center;padding:6px 11px;border-radius:9px;border:1px solid var(--line);background:rgba(255,255,255,.03);color:#cdd9e2;font-size:.72rem;font-weight:900;letter-spacing:.04em;text-decoration:none;cursor:pointer}
.mini:hover{border-color:rgba(76,229,255,.35);color:#fff}
.mini.danger{color:#ffb4c2;border-color:rgba(255,93,122,.28)}
.mini.danger:hover{border-color:rgba(255,93,122,.6)}

/* Pill-style radio / checkbox lists (RadioButtonList / CheckBoxList, RepeatLayout=Flow) */
.opts{display:block;position:relative}
.opts input{position:absolute;opacity:0;width:1px;height:1px}
.opts label{display:inline-block;margin:0 8px 8px 0;padding:10px 15px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.03);color:#b9c7d2;font-size:.9rem;font-weight:800;cursor:pointer;transition:.18s;text-transform:none;letter-spacing:0}
.opts label:hover{border-color:rgba(76,229,255,.4);color:#fff}
.opts input:checked+label{color:#061018;background:linear-gradient(135deg,var(--cyan),#9bf4ff);border-color:transparent;box-shadow:0 8px 24px rgba(76,229,255,.16)}
.opts input:focus-visible+label{outline:2px solid var(--cyan);outline-offset:2px}
.opts.rate label{min-width:48px;text-align:center}
.rate-hint{display:flex;justify-content:space-between;max-width:290px;color:#667a89;font-size:.7rem;font-weight:800;margin:-2px 0 4px}

/* Survey layout */
.survey-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.7fr);gap:18px;align-items:start}
.survey-side{position:sticky;top:104px}
.big-num{font-size:3rem;font-weight:950;letter-spacing:-.05em;line-height:1;color:var(--cyan)}
.thanks{text-align:center;padding:46px 26px}
.thanks .tick{width:76px;height:76px;margin:0 auto 18px;border-radius:50%;display:grid;place-items:center;font-size:2rem;font-weight:950;color:#061018;background:linear-gradient(135deg,var(--green),var(--cyan));box-shadow:0 0 45px rgba(67,245,167,.2)}
.thanks h2{font-size:2rem}
.thanks p{color:#9eb0bd;line-height:1.7;max-width:560px;margin:10px auto}
.thanks .hero-actions{justify-content:center}

/* Long Long Forum */
.forum-layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:18px;align-items:start}
.forum-side{position:sticky;top:104px;display:grid;gap:14px}
.cat-list{display:grid;gap:4px}
.cat-list a{display:flex;justify-content:space-between;gap:8px;padding:10px 12px;border-radius:11px;color:#9bacb8;text-decoration:none;font-weight:800;font-size:.88rem;border:1px solid transparent}
.cat-list a:hover{color:#fff;background:rgba(255,255,255,.04)}
.cat-list a.on{color:#071016;background:linear-gradient(135deg,var(--cyan),#9af1ff)}
.cat-list a small{opacity:.7;font-weight:900}
.thread{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;padding:20px 22px;border-radius:18px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(15,23,32,.92),rgba(7,11,16,.94));text-decoration:none;transition:.22s}
.thread:hover{transform:translateY(-3px);border-color:rgba(76,229,255,.3)}
.thread h3{margin:7px 0 5px;font-size:1.15rem;letter-spacing:-.01em;overflow-wrap:anywhere}
.thread .excerpt{color:#8fa0af;font-size:.9rem;line-height:1.55;margin:0;overflow-wrap:anywhere}
.thread .count{text-align:center;min-width:64px;padding:9px 10px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.03)}
.thread .count b{display:block;font-size:1.2rem;color:var(--cyan)}
.thread .count small{color:#6f8492;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;font-weight:900}
.tag{display:inline-block;padding:4px 9px;border-radius:999px;border:1px solid rgba(76,229,255,.2);background:rgba(76,229,255,.07);color:#9af2ff;font-size:.62rem;font-weight:950;letter-spacing:.11em;text-transform:uppercase}
.meta{color:#71869a;font-size:.78rem;font-weight:700}
.meta b{color:#b9c7d2}
.post{padding:24px;border-radius:20px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(15,23,32,.92),rgba(7,11,16,.94))}
.post.op{border-color:rgba(76,229,255,.22)}
.post.reply{margin-left:28px}
.post h2{margin:10px 0 8px;font-size:clamp(1.5rem,3vw,2.2rem);letter-spacing:-.03em;overflow-wrap:anywhere}
.post-top{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}
.post-actions{display:flex;gap:6px}
.post-body{color:#c3d0da;line-height:1.75;margin:12px 0 0;white-space:pre-wrap;overflow-wrap:anywhere}
.avatar{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;margin-right:9px;vertical-align:middle;font-weight:950;color:#061018;background:linear-gradient(135deg,var(--cyan),var(--violet))}
.empty{padding:34px;text-align:center;color:#8fa0af;border:1px dashed rgba(255,255,255,.14);border-radius:18px}
.crumb{display:inline-block;margin-bottom:16px;color:#8fa0af;text-decoration:none;font-weight:800;font-size:.85rem}
.crumb:hover{color:var(--cyan)}

@media(max-width:1050px){.survey-grid,.forum-layout{grid-template-columns:1fr}.survey-side,.forum-side{position:static}}
@media(max-width:720px){.page-wrap{padding:104px 20px 56px}.form-row{grid-template-columns:1fr}.post.reply{margin-left:12px}.thread{grid-template-columns:1fr}.thread .count{display:none}}

    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <%-- ===== Top bar: brand + progress navigation (built from NavPages in BuildLab.Master.cs) ===== --%>
        <header class="topbar">
            <a class="brand" href="<%: Href(NavPages[0]) %>">
                <span class="brand-mark"></span>
                <span>BUILD//LAB<small>INTERACTIVE PC ASSEMBLY</small></span>
            </a>
            <nav aria-label="Build progress" class="progress-nav">
                <% foreach (var p in NavPages) { %>
                <% bool extra = p.File == "Survey.aspx" || p.File == "LongLongForum.aspx"; %>
                <% if (p.File == "Survey.aspx") { %><span class="nav-sep" aria-hidden="true"></span><% } %>
                <a class="<%: (IsCurrent(p) ? "active" : "") + (extra ? " nav-extra" : "") %>" href="<%: Href(p) %>"><%: p.NavLabel %></a>
                <% } %>
            </nav>
        </header>
        <div aria-hidden="true" class="scroll-meter"></div>

        <%-- ===== Page content goes here ===== --%>
        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>

        <%-- ===== Previous / Next cards (only for pages listed in NavPages) ===== --%>
        <% if (CurrentIndex >= 0) { %>
        <footer class="page-nav">
            <div class="page-nav-inner">
                <% if (Previous != null) { %>
                <a class="next-card" href="<%: Href(Previous) %>">
                    <small>Previous</small>
                    <strong>&larr; <%: Previous.FooterLabel %></strong>
                </a>
                <% } %>
                <a class="next-card next" href="<%: Href(Next) %>">
                    <small><%: NextCaption %></small>
                    <strong><%: NextLabel %></strong>
                </a>
            </div>
        </footer>
        <% } %>
    </form>

    <script src="<%= ResolveUrl("~/js/BuildLab.Master.js") %>"></script>

    <%-- Page-specific scripts (e.g. the FinalChallenge game engine) --%>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
